# Standard .htaccess for Amadika
Options -Indexes
Options +FollowSymLinks

RewriteEngine On

# SEO Friendly Product URLs
RewriteRule ^product/([^/]+)/?$ product-details.php?slug=$1 [L,QSA]

# SEO Friendly Blog URLs
RewriteRule ^blog/([^/]+)/?$ blog-details.php?slug=$1 [L,QSA]

# Rewrite sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Redirect to index.php if file/directory doesn't exist (Optional SEO)
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ index.php [L,QSA]

# Prevent directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Handle PHP errors if needed
# php_value error_reporting 32767
# php_flag display_errors On
